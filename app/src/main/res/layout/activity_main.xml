<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111111"
    android:orientation="vertical"
    android:padding="16dp">

    <ImageView
        android:layout_width="140dp"
        android:layout_height="130dp"
        android:layout_gravity="center_horizontal"
        android:contentDescription="DJ Capuchino"
        android:src="@drawable/logo_capuchino" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:text="DJ Capuchino Llamadas"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/numberDisplay"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:background="#222222"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="32sp" />

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:columnCount="3"
        android:rowCount="4">

        <Button
            android:id="@+id/key1"
            android:layout_width="0dp"
            android:layout_columnWeight="1"
            android:layout_gravity="fill_horizontal"
            android:text="1"
            android:textSize="28sp" />
        <Button
            android:id="@+id/key2"
            android:layout_width="0dp"
            android:layout_columnWeight="1"
            android:layout_gravity="fill_horizontal"
            android:text="2"
            android:textSize="28sp" />
        <Button
            android:id="@+id/key3"
            android:layout_width="0dp"
            android:layout_columnWeight="1"
            android:layout_gravity="fill_horizontal"
            android:text="3"
            android:textSize="28sp" />
        <Button
            android:id="@+id/key4"
            android:layout_width="0dp"
            android:layout_columnWeight="1"
            android:layout_gravity="fill_horizontal"
            android:text="4"
            android:textSize="28sp" />
        <Button
            android:id="@+id/key5"
            android:layout_width="0dp"
            android:layout_columnWeight="1"
            android:layout_gravity="fill_horizontal"
            android:text="5"
            android:textSize="28sp" />
        <Button
            android:id="@+id/key6"
            android:layout_width="0dp"
            android:layout_columnWeight="1"
            android:layout_gravity="fill_horizontal"
            android:text="6"
            android:textSize="28sp" />
        <Button
            android:id="@+id/key7"
            android:layout_width="0dp"
            android:layout_columnWeight="1"
            android:layout_gravity="fill_horizontal"
            android:text="7"
            android:textSize="28sp" />
        <Button
            android:id="@+id/key8"
            android:layout_width="0dp"
            android:layout_columnWeight="1"
            android:layout_gravity="fill_horizontal"
            android:text="8"
            android:textSize="28sp" />
        <Button
            android:id="@+id/key9"
            android:layout_width="0dp"
            android:layout_columnWeight="1"
            android:layout_gravity="fill_horizontal"
            android:text="9"
            android:textSize="28sp" />
        <Button
            android:id="@+id/keyStar"
            android:layout_width="0dp"
            android:layout_columnWeight="1"
            android:layout_gravity="fill_horizontal"
            android:text="*"
            android:textSize="28sp" />
        <Button
            android:id="@+id/key0"
            android:layout_width="0dp"
            android:layout_columnWeight="1"
            android:layout_gravity="fill_horizontal"
            android:text="0"
            android:textSize="28sp" />
        <Button
            android:id="@+id/keyHash"
            android:layout_width="0dp"
            android:layout_columnWeight="1"
            android:layout_gravity="fill_horizontal"
            android:text="#"
            android:textSize="28sp" />
    </GridLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/deleteButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:contentDescription="Borrar"
            android:src="@android:drawable/ic_input_delete" />

        <Button
            android:id="@+id/callButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="8dp"
            android:layout_weight="2"
            android:background="#2E9E4F"
            android:text="Llamar"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/contactsButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Contactos" />

        <Button
            android:id="@+id/recentsButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Recientes" />
    </LinearLayout>

</LinearLayout>
